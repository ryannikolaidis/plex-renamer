<ui:FluentWindow x:Class="PlexRenamer.Views.ShowAnchorPicker"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Pick a show"
                 Width="640"
                 Height="540"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Pick a show for this group" />

        <ui:TextBox x:Name="QueryBox"
                    Grid.Row="1"
                    Margin="0,16,0,8"
                    PlaceholderText="Type a show title…"
                    KeyDown="OnQueryKeyDown" />

        <TextBlock x:Name="VariantNote"
                   Grid.Row="2"
                   FontSize="11"
                   FontStyle="Italic"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Visibility="Collapsed"
                   Margin="0,0,0,8" />

        <ListBox x:Name="CandidatesListBox"
                 Grid.Row="3"
                 BorderThickness="1"
                 BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                 HorizontalContentAlignment="Stretch"
                 SelectionChanged="OnSelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="8,4" Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text=" (" Margin="2,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding Year, TargetNullValue='----'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text=")" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11">
                            <Hyperlink NavigateUri="{Binding ExternalUrl}" RequestNavigate="OnHyperlinkClick">
                                <Run Text="{Binding ExternalUrlLabel, Mode=OneWay}" />
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <ui:Button x:Name="CancelButton" Content="Cancel" Appearance="Secondary" Margin="0,0,8,0" Click="OnCancelClick" />
            <ui:Button x:Name="PickButton" Content="Pick this show" Appearance="Primary" IsEnabled="False" Click="OnPickClick" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
