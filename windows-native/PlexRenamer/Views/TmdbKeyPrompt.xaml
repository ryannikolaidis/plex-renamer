<ui:FluentWindow x:Class="PlexRenamer.Views.TmdbKeyPrompt"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="TMDB API key"
                 Width="480"
                 Height="320"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Configure TMDB" />

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="plex-renamer queries TMDB for movie / TV identification. Paste your API key (v3, the 'API Read Access Token v4' will not work)." />
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <Run Text="Get one for free at " />
                <Hyperlink NavigateUri="https://www.themoviedb.org/settings/api"
                           RequestNavigate="OnHyperlinkRequestNavigate">
                    themoviedb.org → Profile → Settings → API
                </Hyperlink>
                <Run Text="." />
            </TextBlock>
            <ui:TextBox x:Name="KeyBox"
                        PlaceholderText="paste your TMDB API key here"
                        AutomationProperties.Name="TMDB API key" />
            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="If you Skip, plex-renamer cannot anchor files to TMDB and most rows will land unresolved until you paste a key in Settings later." />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <ui:Button x:Name="SkipButton"
                       Content="Skip"
                       Appearance="Secondary"
                       Margin="0,0,8,0"
                       IsCancel="True"
                       Click="OnSkipClick" />
            <ui:Button x:Name="SaveButton"
                       Content="Save"
                       Appearance="Primary"
                       IsDefault="True"
                       Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
