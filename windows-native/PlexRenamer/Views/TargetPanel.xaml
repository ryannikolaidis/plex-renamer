<UserControl x:Class="PlexRenamer.Views.TargetPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="HeaderText"
                       Grid.Row="0"
                       Text="Target (Plex layout)"
                       Margin="12,8,12,4"
                       FontWeight="SemiBold"
                       FontSize="14" />
            <Grid Grid.Row="1">
                <ListBox x:Name="GroupsListBox"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         AutomationProperties.Name="Target groups"
                         AutomationProperties.HelpText="Right-click a group to reveal its parent folder or copy the target path.">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Reveal target folder in Explorer" Click="OnRevealTargetMenuClick" />
                            <MenuItem Header="Copy target label" Click="OnCopyTargetLabelMenuClick" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="12,4">
                                <TextBlock Text="{Binding Label}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Label}" />
                                <TextBlock Text="{Binding Kind}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyStateText"
                           Text="Drop files to see the Plex layout here."
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
