<ui:FluentWindow x:Class="PlexRenamer.Views.SettingsDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Settings"
                 Width="520"
                 Height="480"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Settings" />

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="TMDB API key" FontWeight="SemiBold" />
            <ui:TextBox x:Name="TmdbKeyBox" Margin="0,4,0,12" />

            <TextBlock Text="OMDB API key (optional)" FontWeight="SemiBold" />
            <ui:TextBox x:Name="OmdbKeyBox" Margin="0,4,0,12" />

            <TextBlock Text="Movies library root" FontWeight="SemiBold" />
            <ui:TextBox x:Name="MoviesRootBox" Margin="0,4,0,12" />

            <TextBlock Text="TV library root" FontWeight="SemiBold" />
            <ui:TextBox x:Name="TvRootBox" Margin="0,4,0,12" />

            <CheckBox x:Name="CleanupCheckbox" Content="Enable source cleanup after successful copy" Margin="0,4,0,4" />
            <CheckBox x:Name="AutoAcceptCheckbox" Content="Auto-accept top TMDB hit (power-user)" Margin="0,4,0,4" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <ui:Button x:Name="CancelButton" Content="Cancel" Appearance="Secondary" Margin="0,0,8,0" Click="OnCancelClick" />
            <ui:Button x:Name="SaveButton" Content="Save" Appearance="Primary" Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
