<UserControl x:Class="PlexRenamer.Views.RunReport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       x:Name="HeadlineText"
                       FontWeight="SemiBold"
                       FontSize="14"
                       Margin="0,0,0,4" />

            <TextBlock Grid.Row="1"
                       x:Name="SummaryText"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,8" />

            <ScrollViewer Grid.Row="2"
                          x:Name="ErrorsScroller"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          MaxHeight="160">
                <ItemsControl x:Name="ErrorsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Margin="0,2"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <ui:Button x:Name="UndoButton"
                           Content="Undo this batch"
                           Appearance="Secondary"
                           IsEnabled="False"
                           Click="OnUndoClick" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
