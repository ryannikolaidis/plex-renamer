<ui:FluentWindow x:Class="PlexRenamer.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:PlexRenamer.Views"
                 Title="plex-renamer"
                 Width="1400"
                 Height="850"
                 MinWidth="900"
                 MinHeight="600"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="plex-renamer" />

        <Grid Grid.Row="1" Margin="16,8,16,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <views:DropZone x:Name="DropZoneControl" Grid.Row="0" Margin="0,0,0,12" />

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <views:SourcePanel x:Name="SourcePanelControl" Grid.Column="0" Margin="0,0,8,0" />
                <views:TargetPanel x:Name="TargetPanelControl" Grid.Column="1" Margin="8,0,0,0" />
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <views:ApplyProgress x:Name="ApplyProgressControl" Margin="0,0,0,8" />
                <views:RunReport x:Name="RunReportControl" Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <views:LibraryRootsInline x:Name="LibraryRootsControl" Grid.Column="0" />
            <views:ActionBar x:Name="ActionBarControl" Grid.Column="1" />
        </Grid>
    </Grid>
</ui:FluentWindow>
